# ---- Runtime ----
NODE_ENV=development
PORT=4000
# Set to 1 (or the number of proxies) when running behind a load balancer / reverse proxy
TRUST_PROXY=0

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/carsales?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=50
# Build indexes on boot. In large production clusters prefer `npm run db:indexes` during deploy and set false.
MONGODB_AUTO_INDEX=true

# ---- Redis (optional) ----
# When set, Redis backs caching, rate limiting and view counters (needed for multiple API instances).
# When empty, an in-process fallback is used (fine for a single instance / local dev).
REDIS_URL=

# ---- Web / CORS ----
CORS_ORIGINS=http://localhost:3100
# Optional, at least 32 characters. Set the same value in web-next, so the pages its server renders
# for everyone don't all count against one IP's rate limit.
INTERNAL_API_KEY=

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---- Listings ----
# true = new listings wait for admin approval before going live
LISTING_MODERATION=false
LISTING_TTL_DAYS=60
DEFAULT_PHONE_REGION=IN

# ---- Email (password reset links) ----
# Public address of the website; reset links in emails point here.
WEB_APP_URL=http://localhost:3100
# log = write emails to the API log (development only). smtp = send through any SMTP service.
MAIL_DRIVER=log
MAIL_APP_NAME=CarBazaar
# Required for smtp, e.g. CarBazaar <no-reply@yourdomain.com>
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# true for port 465; false for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- Media storage ----
# local = write to ./uploads (dev). s3 = any S3-compatible store (AWS S3, Cloudflare R2, DO Spaces...)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:4000/uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Docs ----
SWAGGER_ENABLED=true
RATE_LIMIT_ENABLED=true

# ---- Seed admin (npm run seed:admin) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin
ADMIN_PHONE=
