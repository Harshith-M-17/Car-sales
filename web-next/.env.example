# Where the NestJS API lives. Used when rendering pages on the server, and for the /api and
# /uploads rewrites, which Next writes into the build: set this before running `next build`.
API_ORIGIN=http://localhost:4000

# Optional. The same value as INTERNAL_API_KEY in the API, so pages this server renders for everyone
# don't all count against one IP's rate limit. Never give it a NEXT_PUBLIC_ name.
INTERNAL_API_KEY=

# What the browser calls. Relative by default, so requests go through this site's own origin.
NEXT_PUBLIC_API_URL=/api/v1
